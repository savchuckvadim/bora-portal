    {
      "clientId": "portal-api",
      "publicClient": false,
      "secret": "portal-api-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "matrix",
      "publicClient": false,
      "secret": "matrix-client-secret",
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8008/*"
      ],
      "protocol": "openid-connect"
    }
  ],
  "roles": {
    "realm": [
      { "name": "admin" },
      { "name": "editor" },
      { "name": "user" }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bora",
      "lastName": "Admin",
      "email": "admin@bora.local",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    }
  ]
